{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.skills/requirements-extractor/extracted_requirements.schema.json",
  "title": "Extracted requirements register",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "sources",
    "functional_requirements",
    "non_functional_requirements",
    "business_rules",
    "assumptions",
    "constraints",
    "dependencies",
    "open_items",
    "conflicts",
    "coverage_control"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "artifact_kind", "version"],
      "properties": {
        "product": { "type": "string", "minLength": 1 },
        "artifact_kind": { "const": "registro_requisitos" },
        "version": { "type": "string", "minLength": 1 },
        "scope_note": { "type": "string" }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/source" }
    },
    "stakeholders": {
      "type": "array",
      "items": { "$ref": "#/$defs/stakeholder" }
    },
    "functional_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/functionalRequirement" }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonFunctionalRequirement" }
    },
    "business_rules": {
      "type": "array",
      "items": { "$ref": "#/$defs/businessRule" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "#/$defs/constraint" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "open_items": {
      "type": "array",
      "items": { "$ref": "#/$defs/openItem" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/$defs/conflict" }
    },
    "coverage_control": {
      "$ref": "#/$defs/coverageControl"
    }
  },
  "$defs": {
    "artifactId": {
      "type": "string",
      "pattern": "^(RF-[0-9]{2,4}(\\.[0-9]{1,3})?|RNF-[0-9]{2,4}|RN-[0-9]{2,4}|RES-[0-9]{2,4}|DEP-[0-9]{2,4}|SUP-[0-9]{2,4})$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "type"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-[0-9]{2,4}$" },
        "title": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["entrevista", "minuta", "documento", "formulario", "manual", "reporte", "norma", "sistema_existente", "otro"]
        },
        "location": { "type": "string" },
        "limitations": { "type": "string" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "locator"],
      "properties": {
        "source_id": { "type": "string", "pattern": "^SRC-[0-9]{2,4}$" },
        "locator": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" }
      }
    },
    "stakeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "evidence"],
      "properties": {
        "id": { "type": "string", "pattern": "^STK-[0-9]{2,4}$" },
        "label": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "functionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "statement", "origin", "evidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^RF-[0-9]{2,4}(\\.[0-9]{1,3})?$" },
        "level": { "type": "string", "enum": ["global", "detallado"] },
        "parent_id": { "type": "string", "pattern": "^RF-[0-9]{2,4}$" },
        "statement": { "type": "string", "minLength": 1 },
        "actors": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "priority": { "type": "string", "enum": ["alta", "media", "baja", "TBD"] },
        "origin": { "$ref": "#/$defs/origin" },
        "derivation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        { "if": { "properties": { "level": { "const": "detallado" } } }, "then": { "required": ["parent_id"] } },
        { "if": { "properties": { "level": { "const": "global" } } }, "then": { "not": { "required": ["parent_id"] } } },
        {
          "if": { "properties": { "origin": { "const": "derivado" } } },
          "then": {
            "required": ["derivation"],
            "properties": {
              "status": { "const": "pendiente_validacion" },
              "evidence": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "nonFunctionalRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "statement", "scope", "measurement", "origin", "evidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^RNF-[0-9]{2,4}$" },
        "category": { "type": "string", "enum": ["producto", "organizacional", "externo", "TBD"] },
        "subcategory": { "type": "string" },
        "statement": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scale", "conditions", "target"],
          "properties": {
            "scale": { "type": "string", "minLength": 1 },
            "conditions": { "type": "string", "minLength": 1 },
            "target": { "type": "string", "minLength": 1 },
            "verification": { "type": "string" }
          }
        },
        "origin": { "$ref": "#/$defs/origin" },
        "derivation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "derivado" } } },
          "then": {
            "required": ["derivation"],
            "properties": {
              "status": { "const": "pendiente_validacion" },
              "evidence": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "businessRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "origin", "evidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^RN-[0-9]{2,4}$" },
        "statement": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "derivation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "derivado" } } },
          "then": {
            "required": ["derivation"],
            "properties": {
              "status": { "const": "pendiente_validacion" },
              "evidence": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "basis", "validation_question", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^SUP-[0-9]{2,4}$" },
        "statement": { "type": "string", "minLength": 1 },
        "basis": { "type": "string", "enum": ["fuente", "hipotesis_analista"] },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
        "validation_question": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        { "if": { "properties": { "basis": { "const": "fuente" } } }, "then": { "required": ["evidence"] } },
        {
          "if": { "properties": { "basis": { "const": "hipotesis_analista" } } },
          "then": { "properties": { "status": { "const": "pendiente_validacion" } } }
        }
      ]
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "origin", "evidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^RES-[0-9]{2,4}$" },
        "statement": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "derivation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "derivado" } } },
          "then": {
            "required": ["derivation"],
            "properties": {
              "status": { "const": "pendiente_validacion" },
              "evidence": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "origin", "evidence", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^DEP-[0-9]{2,4}$" },
        "statement": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/origin" },
        "derivation": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/evidence" } },
        "status": { "$ref": "#/$defs/status" }
      },
      "allOf": [
        {
          "if": { "properties": { "origin": { "const": "derivado" } } },
          "then": {
            "required": ["derivation"],
            "properties": {
              "status": { "const": "pendiente_validacion" },
              "evidence": { "minItems": 2 }
            }
          }
        }
      ]
    },
    "openItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_ids", "question", "blocking", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^OPEN-[0-9]{2,4}$" },
        "target_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifactId" } },
        "question": { "type": "string", "minLength": 1 },
        "blocking": { "type": "boolean" },
        "status": { "type": "string", "enum": ["abierto", "respondido", "diferido"] }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_ids", "statements", "decision_question", "status"],
      "properties": {
        "id": { "type": "string", "pattern": "^CONF-[0-9]{2,4}$" },
        "target_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifactId" } },
        "statements": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["statement", "evidence"],
            "properties": {
              "statement": { "type": "string", "minLength": 1 },
              "evidence": { "$ref": "#/$defs/evidence" }
            }
          }
        },
        "decision_question": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["pendiente", "resuelto", "diferido"] }
      }
    },
    "coverageControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewed_source_ids", "pending_source_ids", "derived_pending_ids", "blocking_tbd_ids"],
      "properties": {
        "reviewed_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{2,4}$" }
        },
        "pending_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{2,4}$" }
        },
        "derived_pending_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/artifactId" }
        },
        "blocking_tbd_ids": {
          "type": "array",
          "description": "Exact IDs of unresolved blocking open_items; values therefore use the OPEN-* namespace.",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^OPEN-[0-9]{2,4}$"
          }
        },
        "notes": { "type": "string" }
      }
    },
    "origin": { "type": "string", "enum": ["explicito", "derivado"] },
    "status": { "type": "string", "enum": ["confirmado", "pendiente_validacion", "TBD"] }
  }
}
