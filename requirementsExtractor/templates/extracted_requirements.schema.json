{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ExtractedRequirementsSpecification",
  "description": "Esquema JSON formal para la estructuración y validación de requerimientos de software extraídos de entrevistas no estructuradas.",
  "type": "object",
  "required": [
    "metadata",
    "stakeholders",
    "functional_requirements",
    "non_functional_requirements",
    "business_rules",
    "assumptions",
    "constraints",
    "dependencies",
    "ambiguities_and_clarifications"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["project_name", "extraction_timestamp", "analyst_skill", "version"],
      "properties": {
        "project_name": { "type": "string" },
        "source_document_title": { "type": "string" },
        "source_type": { 
          "type": "string",
          "enum": ["interview_transcript", "meeting_minutes", "audio_notes", "workshop_output", "mixed_unstructured"]
        },
        "extraction_timestamp": { "type": "string", "format": "date-time" },
        "analyst_skill": { "type": "string" },
        "version": { "type": "string" }
      }
    },
    "stakeholders": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "role", "organization_unit"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "role": { "type": "string" },
          "organization_unit": { "type": "string" },
          "influence_level": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "primary_interests": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "primary_actor",
          "priority",
          "associated_business_rules",
          "source_traceability"
        ],
        "properties": {
          "id": { 
            "type": "string",
            "pattern": "^RF-[0-9]{2,4}$"
          },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "module_or_epic": { "type": "string" },
          "primary_actor": { "type": "string" },
          "secondary_actors": { "type": "array", "items": { "type": "string" } },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "outputs": { "type": "array", "items": { "type": "string" } },
          "associated_business_rules": { 
            "type": "array", 
            "items": { "type": "string", "pattern": "^RN-[0-9]{2,4}$" } 
          },
          "priority": { 
            "type": "string", 
            "enum": ["Must Have", "Should Have", "Could Have", "Won't Have (This Time)"] 
          },
          "source_traceability": {
            "type": "object",
            "required": ["stakeholder_id", "quote", "paragraph_or_time_ref"],
            "properties": {
              "stakeholder_id": { "type": "string" },
              "quote": { "type": "string" },
              "paragraph_or_time_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "non_functional_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "furps_category",
          "iso25010_dimension",
          "subcharacteristic",
          "planguage_specification",
          "priority"
        ],
        "properties": {
          "id": { 
            "type": "string",
            "pattern": "^RNF-[0-9]{2,4}$"
          },
          "title": { "type": "string" },
          "furps_category": { 
            "type": "string", 
            "enum": ["Functionality", "Usability", "Reliability", "Performance", "Supportability", "+Constraints"] 
          },
          "iso25010_dimension": { 
            "type": "string",
            "enum": [
              "Functional Suitability",
              "Performance Efficiency",
              "Compatibility",
              "Usability",
              "Reliability",
              "Security",
              "Maintainability",
              "Portability"
            ]
          },
          "subcharacteristic": { "type": "string" },
          "planguage_specification": {
            "type": "object",
            "required": ["scale", "meter", "worst_acceptable", "target_plan"],
            "properties": {
              "scale": { "type": "string" },
              "meter": { "type": "string" },
              "baseline": { "type": "string" },
              "worst_acceptable": { "type": "string" },
              "target_plan": { "type": "string" },
              "stretch_wish": { "type": "string" }
            }
          },
          "priority": { 
            "type": "string", 
            "enum": ["Critical", "High", "Medium", "Low"] 
          },
          "source_traceability": {
            "type": "object",
            "properties": {
              "stakeholder_id": { "type": "string" },
              "quote": { "type": "string" },
              "paragraph_or_time_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "business_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "statement", "rule_type", "enforcement_level"],
        "properties": {
          "id": { 
            "type": "string",
            "pattern": "^RN-[0-9]{2,4}$"
          },
          "title": { "type": "string" },
          "statement": { "type": "string" },
          "rule_type": { 
            "type": "string", 
            "enum": ["Constraint", "Derivation/Calculation", "Action Enabler", "Inference"] 
          },
          "logic_or_formula": { "type": "string" },
          "enforcement_level": { 
            "type": "string", 
            "enum": ["Strict/Mandatory", "Overridable with Authorization", "Informational Guideline"] 
          },
          "source_traceability": {
            "type": "object",
            "properties": {
              "stakeholder_id": { "type": "string" },
              "quote": { "type": "string" },
              "paragraph_or_time_ref": { "type": "string" }
            }
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "risk_if_invalid", "validation_action"],
        "properties": {
          "id": { "type": "string", "pattern": "^SUP-[0-9]{2,4}$" },
          "statement": { "type": "string" },
          "risk_if_invalid": { "type": "string" },
          "validation_action": { "type": "string" }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "constraint_type", "description", "rationale"],
        "properties": {
          "id": { "type": "string", "pattern": "^RES-[0-9]{2,4}$" },
          "title": { "type": "string" },
          "constraint_type": { 
            "type": "string", 
            "enum": ["Technical", "Regulatory/Legal", "Architectural", "Hardware/Environmental", "Budget/Schedule"] 
          },
          "description": { "type": "string" },
          "rationale": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "type", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEP-[0-9]{2,4}$" },
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["External API", "Legacy Database", "Third-party Hardware", "Prior Business Process"] },
          "description": { "type": "string" },
          "criticality": { "type": "string", "enum": ["High", "Medium", "Low"] }
        }
      }
    },
    "ambiguities_and_clarifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "raw_excerpt", "detected_term", "risk", "clarification_question", "suggested_options"],
        "properties": {
          "id": { "type": "string", "pattern": "^AMB-[0-9]{2,4}$" },
          "target_stakeholder": { "type": "string" },
          "raw_excerpt": { "type": "string" },
          "detected_term": { "type": "string" },
          "risk": { "type": "string" },
          "clarification_question": { "type": "string" },
          "suggested_options": { 
            "type": "array", 
            "items": { "type": "string" } 
          }
        }
      }
    },
    "conflicts_and_tradeoffs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stakeholders_involved", "conflict_description", "proposed_resolution_options"],
        "properties": {
          "id": { "type": "string", "pattern": "^CONF-[0-9]{2,4}$" },
          "stakeholders_involved": { "type": "array", "items": { "type": "string" } },
          "conflict_description": { "type": "string" },
          "proposed_resolution_options": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string", "enum": ["Pending Decision", "Resolved", "Deferred"] }
        }
      }
    }
  }
}
