{
  "id": "Process_Request",
  "name": "Gestionar solicitud",
  "process": [
    {
      "type": "startEvent",
      "id": "start_request",
      "label": "Solicitud recibida",
      "lane": "Lane_Atencion"
    },
    {
      "type": "task",
      "id": "task_record_request",
      "label": "Registrar solicitud",
      "lane": "Lane_Atencion"
    },
    {
      "type": "exclusiveGateway",
      "id": "gw_data_result",
      "has_join": false,
      "lane": "Lane_Atencion",
      "branches": [
        {
          "condition": "Datos incompletos",
          "path": [
            {
              "type": "endEvent",
              "id": "end_incomplete",
              "label": "Solicitud incompleta",
              "lane": "Lane_Atencion"
            }
          ]
        },
        {
          "condition": "Datos completos",
          "path": []
        }
      ]
    },
    {
      "type": "task",
      "id": "task_resolve_request",
      "label": "Resolver solicitud",
      "lane": "Lane_Responsable"
    },
    {
      "type": "endEvent",
      "id": "end_resolved",
      "label": "Solicitud resuelta",
      "lane": "Lane_Responsable"
    }
  ]
}
