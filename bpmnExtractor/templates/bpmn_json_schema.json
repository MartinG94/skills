{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BPMN-IR single-process model",
  "description": "Tree representation for one non-executable white-box process with lanes and sequence flows. It does not model collaborations, message flows, BPMNDI or engine extensions.",
  "type": "object",
  "required": ["id", "name", "process"],
  "properties": {
    "id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
    "process": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/element" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "lane": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
    },
    "task": {
      "type": "object",
      "required": ["type", "id", "label"],
      "properties": {
        "type": {
          "enum": ["task", "userTask", "serviceTask", "sendTask", "receiveTask", "businessRuleTask", "manualTask", "scriptTask"]
        },
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "lane": { "$ref": "#/$defs/lane" }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["type", "id", "label"],
      "properties": {
        "type": {
          "enum": ["startEvent", "endEvent", "intermediateThrowEvent", "intermediateCatchEvent"]
        },
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "eventDefinition": { "enum": ["timerEventDefinition", "messageEventDefinition"] },
        "lane": { "$ref": "#/$defs/lane" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": { "enum": ["endEvent", "intermediateThrowEvent"] }
            }
          },
          "then": {
            "properties": {
              "eventDefinition": { "const": "messageEventDefinition" }
            }
          }
        }
      ],
      "additionalProperties": false
    },
    "exclusiveBranch": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "condition": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "next": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "is_default": { "type": "boolean", "default": false }
      },
      "oneOf": [
        { "required": ["condition"] },
        {
          "required": ["is_default"],
          "properties": { "is_default": { "const": true } }
        }
      ],
      "additionalProperties": false
    },
    "inclusiveBranch": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "condition": { "type": "string", "minLength": 1, "pattern": ".*\\S.*" },
        "path": {
          "type": "array",
          "items": { "$ref": "#/$defs/element" }
        },
        "next": {
          "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }]
        },
        "is_default": { "type": "boolean", "default": false }
      },
      "oneOf": [
        { "required": ["condition"] },
        {
          "required": ["is_default"],
          "properties": { "is_default": { "const": true } }
        }
      ],
      "additionalProperties": false
    },
    "exclusiveGateway": {
      "type": "object",
      "required": ["type", "id", "has_join", "branches"],
      "properties": {
        "type": { "const": "exclusiveGateway" },
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "has_join": { "type": "boolean" },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/exclusiveBranch" }
        },
        "lane": { "$ref": "#/$defs/lane" }
      },
      "additionalProperties": false
    },
    "inclusiveGateway": {
      "type": "object",
      "required": ["type", "id", "has_join", "branches"],
      "properties": {
        "type": { "const": "inclusiveGateway" },
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "has_join": { "type": "boolean" },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/inclusiveBranch" }
        },
        "lane": { "$ref": "#/$defs/lane" }
      },
      "additionalProperties": false
    },
    "parallelGateway": {
      "type": "object",
      "required": ["type", "id", "branches"],
      "properties": {
        "type": { "const": "parallelGateway" },
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/element" }
          }
        },
        "lane": { "$ref": "#/$defs/lane" }
      },
      "additionalProperties": false
    },
    "element": {
      "oneOf": [
        { "$ref": "#/$defs/task" },
        { "$ref": "#/$defs/event" },
        { "$ref": "#/$defs/exclusiveGateway" },
        { "$ref": "#/$defs/inclusiveGateway" },
        { "$ref": "#/$defs/parallelGateway" }
      ]
    }
  }
}
