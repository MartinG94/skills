{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BPMN Process Intermediate Representation (BPMN-IR)",
  "description": "Canonical tree-like JSON representation for BPMN 2.0 processes.",
  "type": "object",
  "required": [
    "process"
  ],
  "properties": {
    "process": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/BPMNElement"
      },
      "minItems": 1
    }
  },
  "definitions": {
    "TaskType": {
      "type": "string",
      "enum": [
        "task",
        "userTask",
        "serviceTask",
        "sendTask",
        "receiveTask",
        "businessRuleTask",
        "manualTask",
        "scriptTask"
      ]
    },
    "EventType": {
      "type": "string",
      "enum": [
        "startEvent",
        "endEvent",
        "intermediateThrowEvent",
        "intermediateCatchEvent"
      ]
    },
    "EventDefinitionType": {
      "type": "string",
      "enum": [
        "timerEventDefinition",
        "messageEventDefinition"
      ]
    },
    "BPMNTask": {
      "type": "object",
      "required": [
        "type",
        "id",
        "label"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/TaskType"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "lane": {
          "type": "string",
          "description": "Optional lane or role assignment"
        }
      },
      "additionalProperties": false
    },
    "BPMNEvent": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "$ref": "#/definitions/EventType"
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "eventDefinition": {
          "$ref": "#/definitions/EventDefinitionType"
        },
        "lane": {
          "type": "string",
          "description": "Optional lane or role assignment"
        }
      },
      "additionalProperties": false
    },
    "ExclusiveGatewayBranch": {
      "type": "object",
      "required": [
        "condition",
        "path"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BPMNElement"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "ExclusiveGateway": {
      "type": "object",
      "required": [
        "type",
        "id",
        "label",
        "has_join",
        "branches"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "exclusiveGateway"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "has_join": {
          "type": "boolean"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ExclusiveGatewayBranch"
          },
          "minItems": 2
        },
        "lane": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "InclusiveGatewayBranch": {
      "type": "object",
      "required": [
        "path"
      ],
      "properties": {
        "condition": {
          "type": "string"
        },
        "path": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BPMNElement"
          }
        },
        "next": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_default": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "InclusiveGateway": {
      "type": "object",
      "required": [
        "type",
        "id",
        "label",
        "has_join",
        "branches"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "inclusiveGateway"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "has_join": {
          "type": "boolean"
        },
        "branches": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InclusiveGatewayBranch"
          },
          "minItems": 2
        },
        "lane": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "ParallelGateway": {
      "type": "object",
      "required": [
        "type",
        "id",
        "branches"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "parallelGateway"
          ]
        },
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "branches": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/BPMNElement"
            },
            "minItems": 1
          },
          "minItems": 2
        },
        "lane": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "BPMNElement": {
      "oneOf": [
        {
          "$ref": "#/definitions/BPMNTask"
        },
        {
          "$ref": "#/definitions/BPMNEvent"
        },
        {
          "$ref": "#/definitions/ExclusiveGateway"
        },
        {
          "$ref": "#/definitions/InclusiveGateway"
        },
        {
          "$ref": "#/definitions/ParallelGateway"
        }
      ]
    }
  }
}